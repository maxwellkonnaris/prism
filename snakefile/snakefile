# Define the parameter space for sparsity levels and sequence depth
sparsity_levels = [5, 20] 
sequence_depths = [1000, 5000, 10000, 20000] 
matrix =[TRUE, FALSE]
df = [300, 150, 20]
flow_measurements = [1, 2, 3, 4] 


# Final outputs
rule all:
    input:
        expand("results/covariance_comparisons_sparsity{sp}.rds", sp=sparsity_levels),
        expand("results/prism_combined_sparsity{sp}.rds", sp=sparsity_levels)

# Rule to simulate data for each sparsity and depth
rule simulate_data:
    output:
        abundance="data/abundances_sparsity{sp}_depth{sd}.RData",
        externalscale="data/externalscalemeasurements_sparsity{sp}_depth{sd}.RData",
        forest_plot_data="data/forest_plot_data_sparsity{sp}_depth{sd}.RData"
    params:
        sparsity="{sp}", 
        seq_depth="{sd}",
        dense="{matrix}",
        degrees_freedom="{df}" if "{matrix}" = "TRUE" else "FALSE"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/simulate_data.R"

# Rule to run PRISM method for different flow measurements
rule run_prism:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData",
        externalscale="data/externalscalemeasurements_sparsity{sp}_depth{sd}.RData"
    output:
        "results/prism_results_sparsity{sp}_depth{sd}_sd{flow}.rds"
    params:
        flow="{flow}"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_prism.R"

# Rule to run BAnOCC method for each sparsity and depth level
rule run_banocc:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData"
    output:
        "results/banocc_sensitivity_results_sparsity{sp}_depth{sd}.rds"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_banocc.R"

# Rule to run SpiecEasi method for each sparsity and depth level
rule run_spieceasi:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData"
    output:
        "results/spieceasi_results_sparsity{sp}_depth{sd}.rds"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_spieceasi.R"

# Rule to run SparCC method for each sparsity and depth level
rule run_sparcc:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData"
    output:
        "results/sparcc_results_sparsity{sp}_depth{sd}.rds"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_sparcc.R"

# Rule to run CClasso method for each sparsity and depth level
rule run_cclasso:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData"
    output:
        "results/cclasso_results_sparsity{sp}_depth{sd}.rds"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_cclasso.R"

# Rule to run Proportionality method for each sparsity and depth level
rule run_proportionality:
    input:
        abundances="data/abundances_sparsity{sp}_depth{sd}.RData"
    output:
        "results/proportionality_results_sparsity{sp}_depth{sd}.RData"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/run_proportionality.R"

# Rule to combine PRISM results across flow measurements for each sparsity level
rule combine_prism_results:
    input:
        expand("results/prism_results_sparsity{sp}_depth{sd}_sd{flow}.rds", sp="{sp}", sd=sequence_depths, flow=flow_measurements)
    output:
        "results/prism_combined_sparsity{sp}.rds"
    params:
        sparsity="{sp}"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/combine_prism.R"  # This script will handle combining flows

# Rule to combine all results for varying sequence depth per sparsity level
rule combine_results:
    input:
        expand("results/banocc_sensitivity_results_sparsity{sp}_depth{sd}.rds", sp="{sp}", sd=sequence_depths),
        expand("results/spieceasi_results_sparsity{sp}_depth{sd}.rds", sp="{sp}", sd=sequence_depths),
        expand("results/sparcc_results_sparsity{sp}_depth{sd}.rds", sp="{sp}", sd=sequence_depths),
        expand("results/cclasso_results_sparsity{sp}_depth{sd}.rds", sp="{sp}", sd=sequence_depths),
        expand("results/proportionality_results_sparsity{sp}_depth{sd}.RData", sp="{sp}", sd=sequence_depths)
    output:
        "results/covariance_comparisons_sparsity{sp}.rds"
    params:
        sparsity="{sp}"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/combine_results.R"  # This script combines results across depths for each sparsity

# Rule to generate plots
rule generate_plots:
    input:
        expand("results/covariance_comparisons_sparsity{sp}.rds", sp=sparsity_levels),
        expand("results/prism_combined_sparsity{sp}.rds", sp=sparsity_levels)
    output:
        "plots/forest_plot.png"
    conda:
        "envs/prism.yaml"
    script:
        "scripts/generate_plots.R"
